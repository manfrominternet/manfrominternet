---
interface Props {
  date: string;
  title: string;
  company: string;
  description: string;
}

const { date, title, company, description } = Astro.props;
---

<div class="relative pl-8 pb-12 last:pb-0 group">
  <!-- Linia pionowa -->
  <div class="absolute left-[11px] top-2 h-full w-0.5 bg-slate-200 group-last:hidden"></div>
  
  <!-- Kropka na osi -->
  <div class="absolute left-0 top-2 w-6 h-6 rounded-full border-4 border-white bg-blue-600 shadow-sm group-hover:scale-125 transition-transform duration-300"></div>
  
  <!-- Treść -->
  <div class="space-y-2">
    <span class="text-xs font-black uppercase tracking-widest text-blue-600 bg-blue-50 px-2 py-1 rounded">
      {date}
    </span>
    <h3 class="text-xl font-bold text-slate-900 pt-1">{title}</h3>
    <p class="text-sm font-medium text-slate-500">{company}</p>
    <p class="text-slate-600 leading-relaxed max-w-2xl">
      {description}
    </p>
  </div>
</div>