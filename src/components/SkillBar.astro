---
interface Props {
  name: string;
  level: string; // np. "90%"
  color?: string;
}

const { name, level, color = "bg-blue-600" } = Astro.props;
---

<div class="mb-6 last:mb-0">
  <div class="flex justify-between mb-2">
    <span class="font-bold text-slate-800 tracking-tight">{name}</span>
    <span class="text-sm font-black text-blue-600">{level}</span>
  </div>
  <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200/50">
    <!-- Pasek postępu -->
    <div 
      class={`${color} h-full rounded-full transition-all duration-1000 ease-out`} 
      style={`width: ${level}`}
    >
    </div>
  </div>
</div>