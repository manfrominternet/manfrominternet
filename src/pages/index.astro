---
import imgBackend from '/src/assets/images/backend.png';
import imgDevops from '/src/assets/images/devops.png';
import imgFrontend from '/src/assets/images/frontend.png';
import imgProgrammerGrinding from '/src/assets/images/programmer-grinding.png';
import imgLearningTech from '/src/assets/images/learning-technologies.png';
import imgExperience from '/src/assets/images/gaining-experience.png';
import { getEntry, render } from 'astro:content';
import MainLayout from '/src/layouts/MainLayout.astro';
import PuzzleSection from '/src/components/PuzzleSection.astro';
import Tli from '../components/Tli.astro'; 
import { getLangFromUrl, useTranslations } from '/src/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entry = await getEntry('docs', 'en');
if (!entry) return Astro.redirect('/404');
const { Content, headings } = await render(entry);
---

<MainLayout title={entry.data.title} headings={headings}>
  <PuzzleSection title={t('about')} image={imgProgrammerGrinding.src} layout="stacked">
    <p>
    {t("about_section")}
    </p>
  </PuzzleSection>

  <!-- CONNECTOR -->
<div class="relative h-16 flex items-center justify-center">

  <!-- vertical line -->
  <div class="absolute top-0 bottom-0 w-px bg-slate-300 opacity-40"></div>

  <!-- node -->
  <div class="w-2.5 h-2.5 bg-slate-900 rounded-full relative z-10">
    <div class="absolute inset-0 scale-150 border border-slate-400 rounded-full opacity-40"></div>
  </div>

</div>

  <PuzzleSection title={t('goals')} image={imgExperience .src}  reverse={true} layout="image-heavy">
  <p>
  {t('goals_section')}
</p>
<ul class="list-disc pl-5 space-y-2">
  <li>Strong understanding and proficiency in Kubernetes and Terraform</li>
  <li>Efficient, lightweight, and well-crafted frontend</li>
  <li>Backend and database tailored to real needs</li>
  <li>Building practical and useful online products</li>
</ul>
  </PuzzleSection>

<!-- CONNECTOR -->
<div class="relative h-16 flex items-center justify-center">

  <!-- vertical line -->
  <div class="absolute top-0 bottom-0 w-px bg-slate-300 opacity-40"></div>

  <!-- node -->
  <div class="w-2.5 h-2.5 bg-slate-900 rounded-full relative z-10">
    <div class="absolute inset-0 scale-150 border border-slate-400 rounded-full opacity-40"></div>
  </div>

</div>

  <PuzzleSection title={t('experience')} images={[imgDevops.src, imgBackend.src, imgFrontend.src]}>
    <!-- Tutaj wstawiamy Timeline zamiast zwykłego <p> -->
    <div class="mt-6">
<Tli 
  date="2026[October] - Present"
  title="DevOps (German-speaking)"
  company="Capgemini"
  description="Working on a project"
/>
<Tli 
  date="2025[October] - 2026[March]"
  title="DevOps Intern"
  company="Capgemini"
  description="Preparation by Capgemini for future DevOps projects"
/>
<Tli 
  date="2025[March] - 2025[September]"
  title="Fullstack Developer"
  company="Freelance"
  description="Building an MVP — a recruitment platform with quizzes for candidates"
/>
<Tli 
  date="2022[May] - 2024[April]"
  title="Frontend Developer"
  company="Thales"
  description="Building a GUI using Next.js and Tauri"
/>
    </div>
  </PuzzleSection>

</MainLayout>