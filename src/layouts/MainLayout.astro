---
const { title, headings } = Astro.props;
import '../styles/global.css';
import SkillBar from '../components/SkillBar.astro';
---
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-slate-900">
    <!-- Nawigacja -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-black tracking-tighter text-blue-600">PORTFOLIO.</a>
        <div class="flex gap-6 font-bold text-sm">
          <a href="/pl/" class="hover:text-blue-600">PL</a>
          <a href="/de/" class="hover:text-blue-600">DE</a>
          <a href="/" class="hover:text-blue-600">EN</a>
          <a href="/ru/" class="hover:text-blue-600">RU</a>
        </div>
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row gap-16">
      <!-- Spis Treści (TOC) -->
      <aside class="hidden lg:block w-64 pt-20">
        <div class="sticky top-32 space-y-4">
          <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-400">Nawigacja</p>
          <ul class="space-y-4 border-l-2 border-slate-100 pl-6">
            {headings?.map((h: any) => (
              <li>
                <a href={`#${h.slug}`} class="text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors block">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <!-- Główna Treść -->
      <main class="flex-1">
        <slot />

<section id="techstack" class="py-20 border-t border-slate-100 overflow-hidden">
  <!-- Header -->
  <div class="mb-12 px-4">
    <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-2">Technical Skills</h2>
    <p class="text-blue-600 font-bold uppercase tracking-widest text-xs">Expertise & Tools</p>
  </div>

  <div class="space-y-12 px-4">
    
    <!-- 1. PROGRESS BARS (Compressed Gaps) -->
    <div class="max-w-6xl">
      <h3 class="text-base font-bold text-slate-800 mb-6 uppercase tracking-wider border-b pb-2 border-slate-50">Core Stack & Languages</h3>
      <!-- Zmniejszony gap-x z 16 na 8, aby uniknąć overflow na mniejszych laptopach -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
        <div class="space-y-5">
          <SkillBar name="React" level="95%" color="bg-orange-500" />
          <SkillBar name="TypeScript" level="85%" color="bg-blue-500" />
          <SkillBar name="Tailwind CSS" level="98%" color="bg-cyan-400" />
          <SkillBar name="SQL & Postgres" level="100%" color="bg-red-500" />
        </div>
        <div class="space-y-5">
          <SkillBar name="NestJS" level="70%" color="bg-green-600" />
          <SkillBar name="Git / CI/CD Jenkins" level="90%" color="bg-slate-800" />
          <SkillBar name="Traefik" level="90%" color="bg-blue-600" />
          <SkillBar name="Docker Kubernetes Terraform" level="75%" color="bg-yellow-500" />
        </div>
      </div>
    </div>

    <!-- 2. TAGS SECTIONS (Flex-wrap with limited width) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-full">
      
      <!-- Group 1 -->
      <div class="min-w-0">
        <h4 class="text-[11px] font-black text-blue-600 uppercase tracking-[0.2em] mb-4">Programming</h4>
        <div class="flex flex-wrap gap-1.5">
          {["JavaScript", "HTML5", "Python", "Rust", "Bash", "JSON", "YAML"].map(item => (
            <span class="px-2.5 py-1 bg-slate-50 text-slate-600 text-xs font-medium rounded-md border border-slate-200 whitespace-nowrap">{item}</span>
          ))}
        </div>
      </div>

      <!-- Group 2 -->
      <div class="min-w-0">
        <h4 class="text-[11px] font-black text-blue-600 uppercase tracking-[0.2em] mb-4">Frontend & UI</h4>
        <div class="flex flex-wrap gap-1.5">
          {["ReactJS", "Redux", "NextJS", "CSS3", "Styled Comp.", "MUI", "AG Grid", "ShadCN"].map(item => (
            <span class="px-2.5 py-1 bg-blue-50/50 text-blue-700 text-xs font-medium rounded-md border border-blue-100 whitespace-nowrap">{item}</span>
          ))}
        </div>
      </div>

      <!-- Group 3 -->
      <div class="min-w-0">
        <h4 class="text-[11px] font-black text-blue-600 uppercase tracking-[0.2em] mb-4">DevOps & Cloud</h4>
        <div class="flex flex-wrap gap-1.5">
          {["Git", "Docker", "K8s", "Ansible", "Jenkins", "Linux", "GitLab", "GitHub Actions"].map(item => (
            <span class="px-2.5 py-1 bg-slate-800 text-slate-100 text-xs font-medium rounded-md whitespace-nowrap">{item}</span>
          ))}
        </div>
      </div>

      <!-- Group 4 -->
      <div class="min-w-0">
        <h4 class="text-[11px] font-black text-blue-600 uppercase tracking-[0.2em] mb-4">Backend & DB</h4>
        <div class="flex flex-wrap gap-1.5">
          {["SQL", "MongoDB", "GraphQL", "REST", "Maven", "Flyway", "SQL-ite"].map(item => (
            <span class="px-2.5 py-1 bg-slate-50 text-slate-600 text-xs font-medium rounded-md border border-slate-200 whitespace-nowrap">{item}</span>
          ))}
        </div>
      </div>

       <!-- Group 5 -->
       <div class="min-w-0">
        <h4 class="text-[11px] font-black text-blue-600 uppercase tracking-[0.2em] mb-4"> Languages</h4>
        <div class="flex flex-wrap gap-1.5">
          {["Russian (Conv.)", "Arabic (A1)", "German (C1)", "English (C1)", "Polish (Native)"].map(item => (
            <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-medium rounded-md border border-emerald-100 whitespace-nowrap">{item}</span>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
      </main>
    </div>

    <footer class="py-20 text-center text-slate-400 text-sm border-t mt-20">
      &copy; 2026 manfrominternet
    </footer>
  </body>
</html>